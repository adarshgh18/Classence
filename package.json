{
  "name": "classence-workspace",
  "version": "1.0.0",
  "description": "Root workspace for Classence MERN application",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm start",
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" --kill-others \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
