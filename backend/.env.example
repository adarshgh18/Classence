# ==============================================================================
# Classence Backend Environment Configuration Template
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Backend Public Base URL (used for media links, socket file URLs, etc.)
# In production, set to your deployed backend origin (e.g., https://api.yourdomain.com)
BACKEND_URL=http://localhost:5000

# Database Connection (MongoDB URI)
# Local: mongodb://127.0.0.1:27017/classence
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/classence?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/classence

# Client Origins for CORS (comma-separated for multiple origins)
# In production, set to your deployed frontend domain (e.g., https://classence.vercel.app)
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Frontend Base URL (used for password-reset links and classroom invite links)
# In production, set to your deployed frontend domain (e.g., https://classence.vercel.app)
FRONTEND_URL=http://localhost:3000

# Authentication & Security
# WARNING: In production (NODE_ENV=production), JWT_SECRET MUST be set to a secure, random string.
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# OTP Verification Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Password Reset Configuration
RESET_TOKEN_EXPIRY_MINUTES=60

# Email / SMTP Configuration (Required in production for OTP and password reset emails)
# Leave blank in development to log outgoing emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@classence.app

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=20971520

# Cloudinary Storage Configuration (Required in production for persistent file storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
